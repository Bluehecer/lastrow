rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'sudheeramadawala@gmail.com';
    }

    match /{collection}/{document} {
      allow read: if collection in ['products', 'news', 'photos', 'topics'];
      allow create, update, delete: if isStoreAdmin()
        && collection in ['products', 'news', 'photos', 'topics'];
    }
  }
}
